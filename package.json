{
  "name": "bta-manager",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:build": "vite build && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "test:unit": "tsx --test src/db/syncEngine.test.ts src/core/bootstrap.test.ts src/db/coreStorage.test.ts",
    "test:functions": "npm --prefix functions run build && node --test functions/lib/syncPlan.test.js functions/lib/permissions.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bta \"node --test tests/rules.test.mjs\"",
    "test": "npm run test:unit && npm run test:functions && npm run test:rules",
    "test:core": "php tests/php/core-sync.php"
  },
  "dependencies": {
    "@capacitor-firebase/app": "^8.6.0",
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor-firebase/firestore": "^8.5.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jszip": "^3.4.0",
    "@types/localforage": "^0.0.33",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jszip": "^3.10.2",
    "localforage": "^1.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "firebase-tools": "^14.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
