# Optional: URL of the BTA sync server. Leave EMPTY for a 100% local/offline app (default).
VITE_API_BASE_URL=""

# Optional (server side): shared secret required on /api routes, and allowed web origins.
# SYNC_API_KEY="change-me-long-random-value"
# ALLOWED_ORIGINS="https://my-domain.com"

# Firebase (multi-entreprises). Valeurs par défaut = .firebaserc / firebase.json.
# VITE_FIREBASE_PROJECT_ID="bta-manager-fab3f"
# VITE_FUNCTIONS_REGION="africa-south1"
